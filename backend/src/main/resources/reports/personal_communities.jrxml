<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="personal_communities" language="java" pageWidth="595" pageHeight="842" columnWidth="547" leftMargin="24" rightMargin="24" topMargin="24" bottomMargin="24" whenNoDataType="AllSectionsNoDetail">
