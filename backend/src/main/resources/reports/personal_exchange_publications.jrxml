<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="personal_exchange_publications" language="java" columnCount="2" printOrder="Horizontal" pageWidth="595" pageHeight="842" columnWidth="265" columnSpacing="17" leftMargin="24" rightMargin="24" topMargin="22" bottomMargin="22" whenNoDataType="AllSectionsNoDetail">
    <parameter name="reportTitle" class="java.lang.String"/>
    <parameter name="studentAlias" class="java.lang.String"/>
    <parameter name="periodLabel" class="java.lang.String"/>
    <parameter name="generatedAt" class="java.lang.String"/>
    <parameter name="summaryLine" class="java.lang.String"/>
    <parameter name="emptyNotice" class="java.lang.String"/>
    <parameter name="kpi1Lbl" class="java.lang.String"/>
    <parameter name="kpi1Val" class="java.lang.String"/>
    <parameter name="kpi2Lbl" class="java.lang.String"/>
    <parameter name="kpi2Val" class="java.lang.String"/>
    <parameter name="kpi3Lbl" class="java.lang.String"/>
    <parameter name="kpi3Val" class="java.lang.String"/>
    <parameter name="kpi4Lbl" class="java.lang.String"/>
    <parameter name="kpi4Val" class="java.lang.String"/>

    <field name="title" class="java.lang.String"/>
    <field name="categoryLabel" class="java.lang.String"/>
    <field name="modalityLabel" class="java.lang.String"/>
    <field name="description" class="java.lang.String"/>
    <field name="statusLabel" class="java.lang.String"/>
    <field name="attachmentsSummary" class="java.lang.String"/>
    <field name="createdAtLabel" class="java.lang.String"/>

    <title height="118">
        <!-- Encabezado de Inventario Leaf Green (franja superior + ficha de modalidades) -->
        <element kind="rectangle" x="0" y="0" width="547" height="10" mode="Opaque" backcolor="#1F5E3B">
            <pen lineWidth="0.0"/>
        </element>
        <element kind="staticText" x="0" y="16" width="290" height="13" forecolor="#2E7D32" fontName="SansSerif" fontSize="8.0" bold="true">
            <text><![CDATA[STEAMBETA CAMPUS · INVENTARIO PERSONAL SOLIDARIO]]></text>
        </element>
        <element kind="textField" x="0" y="30" width="320" height="24" forecolor="#143D26" fontName="SansSerif" fontSize="16.5" bold="true" blankWhenNull="true">
            <expression><![CDATA[$P{reportTitle}]]></expression>
        </element>
        <element kind="textField" x="0" y="56" width="320" height="14" forecolor="#2E5940" fontName="SansSerif" fontSize="8.5" blankWhenNull="true">
            <expression><![CDATA["Autor: " + $P{studentAlias} + "  ·  Período: " + $P{periodLabel}]]></expression>
        </element>
        <element kind="textField" x="0" y="72" width="320" height="13" forecolor="#64748B" fontName="SansSerif" fontSize="7.5" blankWhenNull="true">
            <expression><![CDATA["Generado: " + $P{generatedAt} + " · Sin precios ni transacciones monetarias"]]></expression>
        </element>

        <!-- Resumen compacto por modalidad a la derecha -->
        <element kind="rectangle" x="332" y="16" width="215" height="72" mode="Opaque" backcolor="#ECF7F0">
            <pen lineWidth="0.75" lineColor="#81C784"/>
        </element>
        <element kind="textField" x="342" y="22" width="195" height="15" forecolor="#143D26" fontName="SansSerif" fontSize="9.0" bold="true" blankWhenNull="true">
            <expression><![CDATA["TOTAL PUBLICACIONES: " + $P{kpi1Val}]]></expression>
        </element>
        <element kind="line" x="342" y="40" width="195" height="1" forecolor="#A5D6A7"/>
        <element kind="textField" x="342" y="45" width="64" height="36" forecolor="#1F5E3B" fontName="SansSerif" fontSize="8.0" bold="true" hTextAlign="Center" vTextAlign="Middle" blankWhenNull="true">
            <expression><![CDATA[$P{kpi2Val} + "\nIntercambio"]]></expression>
        </element>
        <element kind="textField" x="408" y="45" width="64" height="36" forecolor="#1F5E3B" fontName="SansSerif" fontSize="8.0" bold="true" hTextAlign="Center" vTextAlign="Middle" blankWhenNull="true">
            <expression><![CDATA[$P{kpi3Val} + "\nDonación"]]></expression>
        </element>
        <element kind="textField" x="474" y="45" width="63" height="36" forecolor="#1F5E3B" fontName="SansSerif" fontSize="8.0" bold="true" hTextAlign="Center" vTextAlign="Middle" blankWhenNull="true">
            <expression><![CDATA[$P{kpi4Val} + "\nPréstamo"]]></expression>
        </element>

        <element kind="line" x="0" y="98" width="547" height="2" forecolor="#34A853"/>
        <element kind="staticText" x="0" y="102" width="547" height="14" forecolor="#2E5940" fontName="SansSerif" fontSize="8.5" bold="true">
            <text><![CDATA[CATÁLOGO DE MATERIALES PUBLICADOS (2 COLUMNAS)]]></text>
        </element>
    </title>

    <!-- Fichas de inventario en cuadrícula de 2 columnas (265 pt cada una) -->
    <detail>
        <band height="122" splitType="Prevent">
            <element kind="rectangle" x="0" y="4" width="265" height="112" mode="Opaque" backcolor="#FFFFFF">
                <pen lineWidth="0.75" lineColor="#B7DFC5"/>
            </element>
            <!-- Cabecera verde de la ficha: Modalidad + Estado -->
            <element kind="rectangle" x="0" y="4" width="265" height="22" mode="Opaque" backcolor="#1F5E3B">
                <pen lineWidth="0.0"/>
            </element>
            <element kind="textField" x="8" y="7" width="145" height="16" forecolor="#FFFFFF" fontName="SansSerif" fontSize="8.5" bold="true" vTextAlign="Middle" blankWhenNull="true">
                <expression><![CDATA[$F{modalityLabel} != null ? $F{modalityLabel}.toUpperCase() : "INTERCAMBIO"]]></expression>
            </element>
            <element kind="textField" x="155" y="7" width="102" height="16" forecolor="#C8E6C9" fontName="SansSerif" fontSize="8.0" bold="true" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true">
                <expression><![CDATA[$F{statusLabel}]]></expression>
            </element>

            <!-- Categoría + Título del material -->
            <element kind="textField" x="8" y="30" width="249" height="13" forecolor="#2E7D32" fontName="SansSerif" fontSize="7.5" bold="true" blankWhenNull="true">
                <expression><![CDATA["CATEGORÍA: " + ($F{categoryLabel} != null ? $F{categoryLabel}.toUpperCase() : "GENERAL")]]></expression>
            </element>
            <element kind="textField" x="8" y="43" width="249" height="24" forecolor="#143D26" fontName="SansSerif" fontSize="9.5" bold="true" blankWhenNull="true">
                <expression><![CDATA[$F{title}]]></expression>
            </element>

            <!-- Descripción -->
            <element kind="textField" x="8" y="68" width="249" height="26" forecolor="#334155" fontName="SansSerif" fontSize="7.8" blankWhenNull="true">
                <expression><![CDATA[$F{description}]]></expression>
            </element>

            <!-- Pie de ficha: Adjuntos y Fecha -->
            <element kind="rectangle" x="0" y="96" width="265" height="20" mode="Opaque" backcolor="#F4FAF6">
                <pen lineWidth="0.5" lineColor="#D9ECE0"/>
            </element>
            <element kind="textField" x="8" y="99" width="160" height="14" forecolor="#2E5940" fontName="SansSerif" fontSize="7.5" vTextAlign="Middle" blankWhenNull="true">
                <expression><![CDATA["Adjuntos: " + $F{attachmentsSummary}]]></expression>
            </element>
            <element kind="textField" x="170" y="99" width="87" height="14" forecolor="#475569" fontName="SansSerif" fontSize="7.5" hTextAlign="Right" vTextAlign="Middle" blankWhenNull="true">
                <expression><![CDATA[$F{createdAtLabel}]]></expression>
            </element>
        </band>
    </detail>

    <pageFooter height="24">
        <element kind="line" x="0" y="3" width="547" height="1" forecolor="#A5D6A7"/>
        <element kind="staticText" x="0" y="8" width="370" height="14" forecolor="#2E5940" fontName="SansSerif" fontSize="8.0">
            <text><![CDATA[SteamBeta Campus · Inventario solidario personal (sin datos privados de contacto)]]></text>
        </element>
        <element kind="textField" x="380" y="8" width="120" height="14" forecolor="#2E5940" fontName="SansSerif" fontSize="8.0" hTextAlign="Right">
            <expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de "]]></expression>
        </element>
        <element kind="textField" x="503" y="8" width="44" height="14" forecolor="#2E5940" fontName="SansSerif" fontSize="8.0" evaluationTime="Report">
            <expression><![CDATA[$V{PAGE_NUMBER}]]></expression>
        </element>
    </pageFooter>

    <summary height="32">
        <element kind="textField" x="0" y="6" width="547" height="20" mode="Opaque" backcolor="#ECF7F0" forecolor="#1F5E3B" fontName="SansSerif" fontSize="8.5" italic="true" vTextAlign="Middle" textAdjust="StretchHeight" blankWhenNull="true">
            <expression><![CDATA["  " + $P{emptyNotice}]]></expression>
            <box leftPadding="6" rightPadding="6"><pen lineWidth="0.5" lineColor="#81C784"/></box>
        </element>
    </summary>
</jasperReport>
