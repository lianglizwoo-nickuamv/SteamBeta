<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="580.0" spacing="14.0" styleClass="modal-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.PublishMaterialDialogController">
    <padding>
        <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
    </padding>

    <!-- Encabezado -->
    <VBox spacing="4.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label styleClass="title" text="Publicar Material de Intercambio" />
        </HBox>
        <Label styleClass="muted" text="Comparte libros, calculadoras, apuntes u otro material académico sin costo." />
        <Separator />
    </VBox>

    <!-- Formulario -->
    <VBox spacing="10.0" styleClass="card">
        <!-- Título -->
        <VBox spacing="4.0">
            <Label styleClass="field-label" text="TÍTULO DEL MATERIAL (2–160 caracteres):" />
            <TextField fx:id="titleField" promptText="Ej. Álgebra de Baldor / Calculadora Casio fx-991LA" styleClass="input" />
        </VBox>

        <!-- Categoría y Tipo de Intercambio -->
        <HBox spacing="14.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="CATEGORÍA DE MATERIAL:" />
                <ComboBox fx:id="categoryCombo" maxWidth="Infinity" styleClass="combo-box" />
            </VBox>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="MODALIDAD:" />
                <ComboBox fx:id="typeCombo" maxWidth="Infinity" styleClass="combo-box" />
            </VBox>
        </HBox>

        <!-- Descripción -->
        <VBox spacing="4.0">
            <Label styleClass="field-label" text="DESCRIPCIÓN Y ESTADO DEL ARTÍCULO (Opcional):" />
            <TextArea fx:id="descriptionArea" prefRowCount="3" promptText="Detalla el estado físico del material, edición o condiciones..." styleClass="text-area" wrapText="true" />
        </VBox>

        <!-- Información de Contacto -->
        <VBox spacing="4.0">
            <Label styleClass="field-label" text="INFORMACIÓN DE CONTACTO (Opcional):" />
            <TextField fx:id="contactField" promptText="Ej. @mi_usuario en Telegram o entrega en biblioteca campus" styleClass="input" />
        </VBox>

        <Label fx:id="errorLabel" managed="false" styleClass="status-error" text="" visible="false" wrapText="true" />
    </VBox>

    <!-- Botones de Acción -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnCancel" onAction="#onCancel" styleClass="secondary" text="Cancelar" />
        <Button fx:id="btnSubmit" onAction="#onSubmit" styleClass="primary" text="+ Publicar Material" />
    </HBox>
</VBox>
