<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="app-background" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.CommunityModerationController">
    <VBox spacing="14.0">
        <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
        </padding>

        <!-- Cabecera de Módulo (Moderación Mattermost) -->
        <VBox spacing="10.0">
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <VBox spacing="4.0">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label fx:id="titleLabel" styleClass="title" text="Panel de Moderación Comunitaria" />
                        <Label styleClass="badge-admin" text="MODERACIÓN" />
                    </HBox>
                    <Label fx:id="subtitleLabel" styleClass="muted" text="Supervisión comunitaria de publicaciones y comentarios reportados." />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#onBack" styleClass="secondary" text="← Volver a la Comunidad" />
            </HBox>
            <Separator />
        </VBox>

        <Label fx:id="statusLabel" styleClass="muted" text="Cargando reportes pendientes de moderación…" />

        <!-- Lista de Reportes -->
        <VBox fx:id="reportsBox" spacing="12.0" />
    </VBox>
</ScrollPane>
