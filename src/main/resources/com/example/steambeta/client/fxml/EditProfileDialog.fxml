<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="540.0" spacing="16.0" style="-fx-background-color: #0b1120; -fx-padding: 24; -fx-border-color: #1e293b; -fx-border-width: 1; -fx-border-radius: 8;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.EditProfileDialogController">
    <!-- Encabezado con Icono y Título -->
    <VBox spacing="4.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label style="-fx-font-size: 24px;" text="👤" />
            <VBox spacing="2.0">
                <Label styleClass="title" text="Editar Perfil Universitario" />
                <Label styleClass="muted" text="Actualiza tu información personal, académica y privacidad de correo." />
            </VBox>
        </HBox>
        <Separator />
    </VBox>

    <!-- Formulario Principal -->
    <VBox spacing="12.0" style="-fx-background-color: #161f30; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #233148; -fx-border-radius: 8;">
        <VBox spacing="4.0">
            <Label styleClass="field-label" text="NOMBRE O ALIAS VISIBLE EN EL CAMPUS (2 a 60 caracteres):" />
            <TextField fx:id="aliasField" promptText="Tu nombre o apodo académico" />
        </VBox>

        <HBox spacing="16.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="UNIVERSIDAD DECLARADA:" />
                <TextField fx:id="uniField" promptText="Ej. Universidad Central, Politécnico..." />
            </VBox>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="CARRERA O ESPECIALIDAD:" />
                <TextField fx:id="careerField" promptText="Ej. Ingeniería Informática..." />
            </VBox>
        </HBox>

        <VBox spacing="4.0">
            <Label styleClass="field-label" text="SEMESTRE ACTUAL (Número de 1 a 20):" />
            <TextField fx:id="semesterField" promptText="Ej. 1, 3, 5..." />
        </VBox>

        <VBox spacing="4.0">
            <Label styleClass="field-label" text="BIOGRAFÍA E INTERESES ACADÉMICOS (Hasta 500 caracteres):" />
            <TextArea fx:id="bioArea" prefRowCount="3" promptText="Cuéntale a tus compañeros tus áreas de interés y proyectos..." wrapText="true" />
        </VBox>

        <CheckBox fx:id="emailPublicCheck" style="-fx-text-fill: #e2e8f0;" text="🌐 Hacer visible mi correo electrónico para otros estudiantes" />

        <Label fx:id="errorLabel" style="-fx-text-fill: #f87171; -fx-font-weight: bold;" visible="false" />
    </VBox>

    <!-- Botones de Acción -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnCancel" onAction="#onCancel" styleClass="secondary" text="Cancelar" />
        <Button fx:id="btnSave" onAction="#onSave" styleClass="primary" text="Guardar Cambios" />
    </HBox>
</VBox>
