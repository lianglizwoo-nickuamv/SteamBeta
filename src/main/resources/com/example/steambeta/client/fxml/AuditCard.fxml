<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="6.0" styleClass="card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.AuditCardController">
    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label fx:id="actionBadge" styleClass="badge-admin" text="SANCTION" />
        <Label fx:id="modLabel" styleClass="field-label" text="Moderador: Admin" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="dateLabel" styleClass="muted" text="01/01/2026" />
    </HBox>
    <Label fx:id="targetReasonLabel" styleClass="muted" text="Destinatario: @login · Motivo..." wrapText="true" />
</VBox>
