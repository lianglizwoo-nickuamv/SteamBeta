<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="560.0" spacing="14.0" styleClass="modal-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.CreateTaskDialogController">
    <padding>
        <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
    </padding>

    <!-- Encabezado -->
    <VBox spacing="4.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label styleClass="title" text="Nueva Tarea / Entrega Académica" />
        </HBox>
        <Label styleClass="muted" text="Registra una tarea, proyecto o entrega en tu organizador personal." />
        <Separator />
    </VBox>

    <!-- Formulario -->
    <VBox spacing="10.0" styleClass="card">
        <!-- Título -->
        <VBox spacing="4.0">
            <Label styleClass="field-label" text="TÍTULO DE LA TAREA (2–160 caracteres):" />
            <TextField fx:id="titleField" promptText="Ej. Informe de laboratorio — Circuitos digitales" styleClass="input" />
        </VBox>

        <!-- Descripción -->
        <VBox spacing="4.0">
            <Label styleClass="field-label" text="DESCRIPCIÓN (Opcional, hasta 500 caracteres):" />
            <TextArea fx:id="descriptionArea" prefRowCount="2" promptText="Detalles sobre entregables, rúbricas o notas..." styleClass="text-area" wrapText="true" />
        </VBox>

        <!-- Proyecto / Materia y Fecha de Entrega -->
        <HBox spacing="14.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="ASIGNATURA / PROYECTO (Opcional):" />
                <ComboBox fx:id="subjectCombo" maxWidth="Infinity" promptText="Elegir de tus materias registradas (opcional)..." styleClass="combo-box" />
                <TextField fx:id="projectField" promptText="Ej. Física II, Proyecto Integrador" styleClass="input" />
            </VBox>
            <VBox maxWidth="180.0" prefWidth="170.0" spacing="4.0">
                <Label styleClass="field-label" text="FECHA DE VENCIMIENTO:" />
                <DatePicker fx:id="dueDatePicker" maxWidth="Infinity" promptText="dd/mm/aaaa" />
            </VBox>
        </HBox>

        <!-- Prioridad -->
        <VBox spacing="4.0">
            <Label styleClass="field-label" text="NIVEL DE PRIORIDAD:" />
            <ComboBox fx:id="priorityCombo" maxWidth="Infinity" styleClass="combo-box" />
        </VBox>

        <Label fx:id="errorLabel" managed="false" styleClass="status-error" text="" visible="false" wrapText="true" />
    </VBox>

    <!-- Botones de Acción -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnCancel" onAction="#onCancel" styleClass="secondary" text="Cancelar" />
        <Button fx:id="btnSubmit" onAction="#onSubmit" styleClass="primary" text="+ Crear Tarea" />
    </HBox>
</VBox>
