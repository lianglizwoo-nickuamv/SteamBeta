<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="560.0" spacing="16.0"
      style="-fx-background-color: #0b1120; -fx-padding: 24; -fx-border-color: #1e293b; -fx-border-width: 1; -fx-border-radius: 8;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.steambeta.client.ui.CreateTaskDialogController">

    <!-- Encabezado -->
    <VBox spacing="4.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label styleClass="brand" text="📋" />
            <VBox spacing="2.0">
                <Label styleClass="title" text="Nueva Tarea / Entrega Académica" />
                <Label styleClass="muted" text="Registra una tarea, proyecto o entrega en tu organizador personal." />
            </VBox>
        </HBox>
        <Separator />
    </VBox>

    <!-- Formulario -->
    <VBox spacing="12.0" style="-fx-background-color: #161f30; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #233148; -fx-border-radius: 8;">

        <!-- Título -->
        <VBox spacing="4.0">
            <Label styleClass="field-label" text="TÍTULO DE LA TAREA (2–160 caracteres):" />
            <TextField fx:id="titleField" promptText="Ej. Informe de laboratorio — Circuitos digitales" />
        </VBox>

        <!-- Descripción -->
        <VBox spacing="4.0">
            <Label styleClass="field-label" text="DESCRIPCIÓN / INSTRUCCIONES (opcional, máx. 3000):" />
            <TextArea fx:id="descriptionArea" prefRowCount="3"
                      promptText="Detalles, requisitos o indicaciones del docente..." wrapText="true" />
        </VBox>

        <!-- Prioridad + Fecha límite -->
        <HBox spacing="16.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="PRIORIDAD:" />
                <ComboBox fx:id="priorityCombo" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="FECHA LÍMITE (AAAA-MM-DD, opcional):" />
                <TextField fx:id="dueDateField" promptText="2026-12-31" />
            </VBox>
        </HBox>

        <!-- Proyecto / materia -->
        <VBox spacing="4.0">
            <Label styleClass="field-label" text="MATERIA O PROYECTO (máx. 100 caracteres):" />
            <TextField fx:id="projectField" promptText="Ej. Cálculo Diferencial, Proyecto de Grado..." />
        </VBox>

        <Label fx:id="errorLabel" style="-fx-text-fill: #f87171; -fx-font-weight: bold;"
               text="" visible="false" wrapText="true" />
    </VBox>

    <!-- Botones -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnCancel" onAction="#onCancel" styleClass="secondary" text="Cancelar" />
        <Button fx:id="btnSubmit" onAction="#onSubmit" styleClass="primary" text="+ Registrar Tarea" />
    </HBox>

</VBox>
