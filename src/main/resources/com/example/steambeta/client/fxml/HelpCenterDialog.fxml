<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="620.0" prefWidth="860.0" spacing="14.0" styleClass="modal-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.HelpCenterDialogController">
    <padding>
        <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
    </padding>

    <!-- Cabecera (Moodle + JabRef) -->
    <VBox spacing="6.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label styleClass="title" text="Centro de Ayuda · SteamBeta Campus" />
            <Label fx:id="moduleBadge" styleClass="badge-admin" text="INICIO" />
        </HBox>
        <Label styleClass="muted" text="Guía contextual en español. Selecciona cualquier módulo para consultar instrucciones paso a paso." />
        <Separator />
    </VBox>

    <HBox spacing="16.0" VBox.vgrow="ALWAYS">
        <!-- Lista de módulos -->
        <VBox minWidth="210.0" prefWidth="220.0" spacing="8.0" styleClass="card">
            <Label styleClass="field-label" text="MÓDULOS DEL CAMPUS" />
            <ListView fx:id="moduleList" VBox.vgrow="ALWAYS" />
        </VBox>

        <!-- Contenido de ayuda del módulo seleccionado -->
        <ScrollPane fitToWidth="true" styleClass="card" HBox.hgrow="ALWAYS">
            <VBox spacing="12.0">
                <padding>
                    <Insets bottom="16.0" left="18.0" right="18.0" top="14.0" />
                </padding>
                <Label fx:id="topicTitle" styleClass="title" text="Inicio" wrapText="true" />
                <Label fx:id="topicPurpose" styleClass="post-body" text="" wrapText="true" />
                <Separator />

                <VBox spacing="4.0">
                    <Label styleClass="field-label" text="QUÉ PUEDES HACER" />
                    <Label fx:id="topicCapabilities" styleClass="post-body" text="" wrapText="true" />
                </VBox>

                <VBox spacing="4.0">
                    <Label styleClass="field-label" text="CÓMO AGREGAR, EDITAR Y ELIMINAR" />
                    <Label fx:id="topicSteps" styleClass="post-body" text="" wrapText="true" />
                </VBox>

                <VBox spacing="4.0">
                    <Label styleClass="field-label" text="PERMISOS Y ALMACENAMIENTO" />
                    <Label fx:id="topicSecurity" styleClass="muted" text="" wrapText="true" />
                </VBox>

                <VBox spacing="4.0">
                    <Label styleClass="field-label" text="SOLUCIÓN A ERRORES COMUNES" />
                    <Label fx:id="topicTroubleshooting" styleClass="muted" text="" wrapText="true" />
                </VBox>
            </VBox>
        </ScrollPane>
    </HBox>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#onClose" styleClass="primary" text="Entendido" />
    </HBox>
</VBox>
