<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="7.0" styleClass="file-card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.ResourceCardController">
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label fx:id="typeBadge" styleClass="badge-role" text="PDF" />
        <Label fx:id="uploaderLabel" styleClass="muted" text="Subido por: Sofia" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="dateLabel" styleClass="muted" text="01/01/2026" />
    </HBox>

    <Label fx:id="titleLabel" styleClass="card-title" text="Título del recurso o material" />
    <Label fx:id="descLabel" styleClass="muted" text="Descripción..." wrapText="true" />
</VBox>
