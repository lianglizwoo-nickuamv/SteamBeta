<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="4.0" styleClass="comment-card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.CommentItemController">
    <padding>
        <Insets bottom="6.0" left="10.0" right="10.0" top="6.0" />
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label fx:id="authorLabel" styleClass="field-label" text="Autor" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="dateLabel" styleClass="muted" text="01/01/2026" />
    </HBox>
    <Label fx:id="bodyLabel" styleClass="muted" text="Contenido del comentario..." wrapText="true" />
</VBox>
