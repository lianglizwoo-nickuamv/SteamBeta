<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="480.0" spacing="16.0" style="-fx-background-color: #0b1120; -fx-padding: 24; -fx-border-color: #1e293b; -fx-border-width: 1; -fx-border-radius: 8;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.MessageDialogController">
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Label fx:id="iconLabel" style="-fx-font-size: 24px;" text="ℹ️" />
        <VBox spacing="2.0">
            <Label fx:id="titleLabel" styleClass="title" text="Notificación de SteamBeta" />
            <Label styleClass="muted" text="Campus Universitario" />
        </VBox>
    </HBox>
    <Separator />

    <VBox spacing="8.0" style="-fx-background-color: #161f30; -fx-padding: 16; -fx-background-radius: 8; -fx-border-color: #233148; -fx-border-radius: 8;">
        <Label fx:id="messageLabel" style="-fx-font-size: 13px; -fx-text-fill: #e2e8f0; -fx-line-spacing: 3;" text="Mensaje..." wrapText="true" />
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnCancel" onAction="#onCancel" styleClass="secondary" text="Cancelar" visible="false" managed="false" />
        <Button fx:id="btnOk" onAction="#onOk" styleClass="primary" text="Aceptar" />
    </HBox>
</VBox>
