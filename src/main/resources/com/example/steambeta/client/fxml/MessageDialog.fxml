<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="480.0" spacing="14.0" styleClass="modal-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.MessageDialogController">
    <padding>
        <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
    </padding>
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Label fx:id="iconLabel" styleClass="dialog-icon" text="[i]" />
        <VBox spacing="2.0">
            <Label fx:id="titleLabel" styleClass="title" text="Notificación de SteamBeta" />
            <Label styleClass="muted" text="Campus Universitario" />
        </VBox>
    </HBox>
    <Separator />

    <VBox spacing="8.0" styleClass="card">
        <Label fx:id="messageLabel" styleClass="post-body" text="Mensaje..." wrapText="true" />
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnCancel" managed="false" onAction="#onCancel" styleClass="secondary" text="Cancelar" visible="false" />
        <Button fx:id="btnOk" onAction="#onOk" styleClass="primary" text="Aceptar" />
    </HBox>
</VBox>
