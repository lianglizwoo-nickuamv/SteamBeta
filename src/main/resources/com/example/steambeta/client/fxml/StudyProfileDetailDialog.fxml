<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="560.0" spacing="12.0" styleClass="modal-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.StudyProfileDetailDialogController">
    <padding>
        <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
    </padding>

    <VBox spacing="4.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label fx:id="aliasLabel" styleClass="title" text="Estudiante" />
            <Label fx:id="careerBadge" styleClass="badge-role" text="Carrera" />
        </HBox>
        <Label fx:id="universityLabel" styleClass="muted" text="Universidad no especificada" wrapText="true" />
        <Separator />
    </VBox>

    <Label fx:id="loadingLabel" styleClass="muted" text="Consultando ficha pública del compañero…" />

    <VBox fx:id="detailCard" managed="false" spacing="10.0" styleClass="card" visible="false">
        <VBox spacing="2.0">
            <Label styleClass="field-label" text="MATERIAS QUE ESTUDIA" />
            <Label fx:id="subjectsLabel" styleClass="post-body" text="Sin materias declaradas" wrapText="true" />
        </VBox>

        <VBox spacing="2.0">
            <Label styleClass="field-label" text="TEMAS DE INTERÉS" />
            <Label fx:id="interestsLabel" styleClass="post-body" text="Sin temas declarados" wrapText="true" />
        </VBox>

        <VBox spacing="2.0">
            <Label styleClass="field-label" text="OFRECE APOYO EN" />
            <Label fx:id="canHelpLabel" styleClass="post-body" text="No especificado" wrapText="true" />
        </VBox>

        <VBox spacing="2.0">
            <Label styleClass="field-label" text="NECESITA APOYO EN" />
            <Label fx:id="needsHelpLabel" styleClass="post-body" text="No especificado" wrapText="true" />
        </VBox>

        <VBox spacing="2.0">
            <Label styleClass="field-label" text="DISPONIBILIDAD" />
            <Label fx:id="availabilityLabel" styleClass="post-body" text="A convenir" wrapText="true" />
        </VBox>

        <VBox fx:id="bioBox" managed="false" spacing="2.0" visible="false">
            <Label styleClass="field-label" text="BIOGRAFÍA ACADÉMICA" />
            <Label fx:id="bioLabel" styleClass="post-body" text="" wrapText="true" />
        </VBox>
    </VBox>

    <!-- Sección de contacto autorizado -->
    <VBox fx:id="contactCard" managed="false" spacing="8.0" styleClass="card" visible="false">
        <Label styleClass="section-title" text="Contacto" />
        <Label fx:id="contactInfoLabel" styleClass="post-body" text="" wrapText="true" />
        <HBox fx:id="contactActionsBox" alignment="CENTER_LEFT" managed="false" spacing="10.0" visible="false">
            <Button fx:id="btnSendEmail" onAction="#onSendEmail" styleClass="primary" text="Enviar correo" />
            <Button fx:id="btnCopyEmail" onAction="#onCopyEmail" styleClass="secondary" text="Copiar correo" />
            <Label fx:id="copyFeedbackLabel" managed="false" styleClass="status-success" text="" visible="false" />
        </HBox>
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#onClose" styleClass="secondary" text="Cerrar" />
    </HBox>
</VBox>
