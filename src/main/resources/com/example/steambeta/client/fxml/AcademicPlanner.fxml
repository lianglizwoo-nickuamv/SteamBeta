<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.AcademicPlannerController">
    <VBox spacing="16.0">
        <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
        </padding>

        <!-- Cabecera de Módulo -->
        <VBox spacing="10.0">
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <VBox spacing="4.0">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label styleClass="title" text="📋 Organizador Académico" />
                        <Label styleClass="badge-admin" text="MI PLANIFICACIÓN" />
                    </HBox>
                    <Label styleClass="muted" text="Organiza tus entregas, deberes y proyectos por estado de avance." />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Button onAction="#onNewTask" styleClass="primary" text="+ Nueva Tarea / Entrega" />
                    <Button onAction="#onRefresh" styleClass="secondary" text="Actualizar" />
                </HBox>
            </HBox>
            <Separator />
        </VBox>

        <!-- Tablero Kanban de 4 Columnas -->
        <HBox spacing="14.0">
            <!-- Columna 1: Pendiente -->
            <VBox prefWidth="260.0" spacing="10.0" style="-fx-background-color: #0b1120; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #1e293b; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                <Label style="-fx-text-fill: #f59e0b;" styleClass="card-title" text="⏳ Pendiente" />
                <VBox fx:id="pendingCol" spacing="10.0" />
            </VBox>

            <!-- Columna 2: En Proceso -->
            <VBox prefWidth="260.0" spacing="10.0" style="-fx-background-color: #0b1120; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #1e293b; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                <Label style="-fx-text-fill: #38bdf8;" styleClass="card-title" text="⚡ En Proceso" />
                <VBox fx:id="progressCol" spacing="10.0" />
            </VBox>

            <!-- Columna 3: En Revisión -->
            <VBox prefWidth="260.0" spacing="10.0" style="-fx-background-color: #0b1120; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #1e293b; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                <Label style="-fx-text-fill: #a855f7;" styleClass="card-title" text="🔍 En Revisión" />
                <VBox fx:id="reviewCol" spacing="10.0" />
            </VBox>

            <!-- Columna 4: Completada -->
            <VBox prefWidth="260.0" spacing="10.0" style="-fx-background-color: #0b1120; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #1e293b; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
                <Label style="-fx-text-fill: #10b981;" styleClass="card-title" text="✓ Completada" />
                <VBox fx:id="completedCol" spacing="10.0" />
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
