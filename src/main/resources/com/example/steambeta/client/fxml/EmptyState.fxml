<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="8.0" styleClass="empty-state" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.EmptyStateController">
    <padding>
        <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
    </padding>
    <HBox alignment="CENTER" spacing="8.0">
        <Label fx:id="iconLabel" style="-fx-font-size: 20px; -fx-text-fill: #A8B0B8;" text="[i]" />
        <Label fx:id="titleLabel" styleClass="card-title" text="Sin contenido disponible" />
    </HBox>
    <Label fx:id="subtitleLabel" alignment="CENTER" styleClass="muted" text="No hay elementos para mostrar en esta sección." textAlignment="CENTER" wrapText="true" />
    <Button fx:id="actionBtn" managed="false" styleClass="primary" visible="false" />
</VBox>
