<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.StudyTeamsController">
    <VBox spacing="16.0">
        <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
        </padding>

        <!-- Cabecera de Módulo -->
        <VBox spacing="10.0">
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <VBox spacing="4.0">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label styleClass="title" text="🤝 Equipos y Compañeros de Estudio" />
                        <Label styleClass="badge-admin" text="COLABORACIÓN" />
                    </HBox>
                    <Label styleClass="muted" text="Encuentra compañeros para repasar materias difíciles, resolver guías o preparar exámenes." />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Button onAction="#onEditProfile" styleClass="primary" text="✏️ Mi Ficha de Estudio" />
                    <Button onAction="#onRefresh" styleClass="secondary" text="Actualizar" />
                </HBox>
            </HBox>
            <Separator />
        </VBox>

        <!-- Barra de búsqueda por materia -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label styleClass="field-label" text="Buscar compañeros por materia:" />
            <TextField fx:id="subjectSearchField" onAction="#onSearch" prefWidth="320.0" promptText="Ej. Álgebra, Programación, Cálculo..." />
            <Button onAction="#onSearch" styleClass="secondary" text="🔍 Buscar" />
        </HBox>

        <!-- Panel de Estado / Mi Perfil de Estudio -->
        <VBox fx:id="myProfileCard" spacing="8.0" styleClass="card" />

        <!-- Listado de Coincidencias de Estudio -->
        <Label styleClass="section-title" text="Compañeros Disponibles" />
        <VBox fx:id="matchesListBox" spacing="12.0" />
    </VBox>
</ScrollPane>
