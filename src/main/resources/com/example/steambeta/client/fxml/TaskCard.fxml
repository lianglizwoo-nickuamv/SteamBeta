<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="7.0" styleClass="task-card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.TaskCardController">
    <HBox alignment="CENTER_LEFT" spacing="6.0">
        <Label fx:id="priorityBadge" styleClass="badge-role" text="Media" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="dueLabel" styleClass="muted" text="Vence: 01/01" />
    </HBox>

    <Label fx:id="titleLabel" styleClass="card-title" text="Título de la entrega" wrapText="true" />
    <Label fx:id="projectBadge" managed="false" styleClass="tag-pill" text="Proyecto" visible="false" />
    <Label fx:id="descLabel" managed="false" styleClass="muted" text="Detalles de la consigna..." visible="false" wrapText="true" />

    <Separator />

    <HBox alignment="CENTER_LEFT" spacing="5.0">
        <Button fx:id="btnProg" onAction="#onProgress" styleClass="secondary, btn-compact" text="En proceso" />
        <Button fx:id="btnRev" onAction="#onReview" styleClass="secondary, btn-compact" text="En revisión" />
        <Button fx:id="btnComp" onAction="#onComplete" styleClass="primary, btn-compact" text="✓ Completar" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnEdit" onAction="#onEdit" styleClass="secondary, btn-compact" text="Editar" />
        <Button fx:id="btnDel" onAction="#onDelete" styleClass="danger-btn, btn-compact" text="✕" />
    </HBox>
</VBox>
