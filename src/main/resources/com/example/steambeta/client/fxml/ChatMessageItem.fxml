<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<HBox fx:id="messageRow" alignment="TOP_LEFT" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.ChatMessageItemController">
    <padding>
        <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
    </padding>

    <!-- Avatar o iniciales del autor -->
    <StackPane fx:id="avatarContainer" maxHeight="38.0" maxWidth="38.0" minHeight="38.0" minWidth="38.0" prefHeight="38.0" prefWidth="38.0" styleClass="chat-avatar-circle">
        <Label fx:id="avatarInitials" styleClass="chat-avatar-initials" text="ES" />
        <ImageView fx:id="avatarImage" fitHeight="38.0" fitWidth="38.0" managed="false" preserveRatio="true" visible="false" />
    </StackPane>

    <!-- Cuerpo del mensaje / pregunta en el chat comunitario -->
    <VBox fx:id="messageBubble" spacing="7.0" styleClass="chat-bubble, chat-bubble-peer" HBox.hgrow="ALWAYS">
        <!-- Encabezado: autor, distintivos y fecha/hora -->
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label fx:id="authorLabel" styleClass="identity" text="Estudiante" />
            <Label fx:id="ownTag" managed="false" styleClass="tag-pill" text="Tú" visible="false" />
            <Label fx:id="kindBadge" managed="false" styleClass="badge-academic" text="PREGUNTA ACADÉMICA" visible="false" />
            <Label fx:id="stateBadge" managed="false" styleClass="badge-pending" text="PENDIENTE" visible="false" />
            <Label fx:id="subjectBadge" managed="false" styleClass="tag-pill" text="Materia" visible="false" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="dateLabel" styleClass="muted" text="01/01/2026 12:00" />
        </HBox>

        <!-- Título (visible en preguntas académicas y anuncios con asunto) -->
        <Label fx:id="titleLabel" managed="false" styleClass="card-title" text="" visible="false" wrapText="true" />

        <!-- Contenido del mensaje -->
        <Label fx:id="bodyLabel" styleClass="post-body" text="Contenido del mensaje..." wrapText="true" />

        <!-- Acciones compactas -->
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Button fx:id="toggleRepliesBtn" onAction="#onToggleReplies" styleClass="secondary, btn-compact" text="Respuestas (0)" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="deleteBtn" managed="false" onAction="#onDelete" styleClass="danger-btn, btn-compact" text="Eliminar" visible="false" />
        </HBox>

        <!-- Hilo de respuestas / comentarios integrado -->
        <VBox fx:id="repliesBox" managed="false" spacing="8.0" styleClass="chat-replies-box" visible="false">
            <padding>
                <Insets bottom="6.0" left="10.0" right="6.0" top="6.0" />
            </padding>
            <Label fx:id="repliesStatusLabel" managed="false" styleClass="muted" text="" visible="false" />
            <VBox fx:id="repliesListBox" spacing="6.0" />
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <TextField fx:id="replyInputField" onAction="#onSendReply" promptText="Escribe una respuesta en este hilo…" styleClass="input" HBox.hgrow="ALWAYS" />
                <Button fx:id="sendReplyBtn" onAction="#onSendReply" styleClass="primary, btn-compact" text="Responder" />
            </HBox>
        </VBox>
    </VBox>
</HBox>
