<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="app-background" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.ProfileController">
    <VBox fx:id="profileContainer" spacing="16.0">
        <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
        </padding>

        <!-- Cabecera de Módulo -->
        <VBox spacing="10.0">
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <VBox spacing="4.0">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label styleClass="title" text="Mi Perfil Estudiantil" />
                        <Label styleClass="badge-admin" text="IDENTIDAD ACADÉMICA" />
                    </HBox>
                    <Label styleClass="muted" text="Gestiona tu fotografía de perfil, trayectoria universitaria, intereses académicos y privacidad de correo." />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                    <Button onAction="#onEditProfile" styleClass="primary" text="Editar Mi Información" />
                    <Button onAction="#onRefresh" styleClass="secondary" text="Actualizar" />
                </HBox>
            </HBox>
            <Separator />
        </VBox>

        <!-- Estado / Carga -->
        <Label fx:id="statusLabel" managed="false" styleClass="muted" text="Cargando tu perfil estudiantil desde PostgreSQL..." visible="false" />

        <!-- Tarjeta Hero: Identidad Estudiantil, Fotografía y Acciones de Foto -->
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="profile-hero">
            <VBox alignment="CENTER" spacing="8.0">
                <StackPane fx:id="avatarCircle" maxHeight="78.0" maxWidth="78.0" minHeight="78.0" minWidth="78.0" prefHeight="78.0" prefWidth="78.0" styleClass="avatar-circle">
                    <ImageView fx:id="avatarImage" fitHeight="78.0" fitWidth="78.0" managed="false" visible="false" />
                    <Label fx:id="avatarInitials" styleClass="avatar-initials" text="ST" />
                </StackPane>
            </VBox>

            <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label fx:id="aliasLabel" styleClass="title" text="Estudiante" />
                    <Label fx:id="handleLabel" styleClass="brand-badge" text="@estudiante" />
                    <Label fx:id="roleBadge" styleClass="badge-role" text="USER" />
                    <Label fx:id="verifiedBadge" managed="false" styleClass="badge-resolved" text="✓ Estudiante Verificado" visible="false" />
                </HBox>
                <Label fx:id="academicSummaryLabel" styleClass="muted" text="Completa tu universidad, carrera y semestre para construir tu ficha académica." wrapText="true" />
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label fx:id="communitiesCountBadge" styleClass="tag-pill" text="0 Comunidades" />
                    <Label fx:id="postsCountBadge" styleClass="tag-pill" text="0 Aportes" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnChangePhoto" onAction="#onChangePhoto" styleClass="secondary, btn-compact" text="Cambiar fotografía" />
                    <Button fx:id="btnDeletePhoto" managed="false" onAction="#onDeletePhoto" styleClass="danger-btn, btn-compact" text="Eliminar fotografía" visible="false" />
                </HBox>
            </VBox>
        </HBox>

        <!-- Disposición en 2 Columnas equilibradas -->
        <HBox spacing="16.0">
            <!-- Columna Izquierda: Trayectoria + Acceso y Contacto -->
            <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                <!-- Trayectoria Universitaria -->
                <VBox spacing="10.0" styleClass="card">
                    <Label styleClass="section-title" text="Trayectoria Universitaria" />
                    <Separator />
                    <GridPane hgap="12.0" vgap="8.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="125.0" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>
                        <Label styleClass="field-label" text="UNIVERSIDAD" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label fx:id="universityLabel" styleClass="post-body" text="No declarada" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label styleClass="field-label" text="CARRERA" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="careerLabel" styleClass="post-body" text="No declarada" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label styleClass="field-label" text="SEMESTRE ACTUAL" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <Label fx:id="semesterLabel" styleClass="post-body" text="No especificado" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    </GridPane>
                    <Label styleClass="muted" text="Información académica declarada por el estudiante · Sin certificación externa." wrapText="true" />
                </VBox>

                <!-- Acceso y Correo Privado -->
                <VBox spacing="10.0" styleClass="card">
                    <Label styleClass="section-title" text="Identidad de Acceso y Contacto" />
                    <Separator />
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label styleClass="field-label" text="CORREO:" />
                        <Label fx:id="emailLabel" styleClass="card-title" text="cargando..." />
                        <Label fx:id="emailTag" styleClass="brand-badge" text="Correo privado" />
                    </HBox>
                    <Label styleClass="muted" text="Tu correo se mantiene confidencial de manera predeterminada. Puedes cambiar su visibilidad al editar tu perfil." wrapText="true" />
                </VBox>
            </VBox>

            <!-- Columna Derecha: Intereses y Biografía -->
            <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                <!-- Áreas de Interés e Investigación Académica -->
                <VBox spacing="10.0" styleClass="card">
                    <Label styleClass="section-title" text="Intereses Académicos y Especialidades" />
                    <Separator />
                    <Label fx:id="interestsLabel" styleClass="post-body" text="Sin intereses académicos registrados." wrapText="true" />
                    <Label styleClass="muted" text="Tus áreas de interés ayudan a conectar con equipos de estudio y oportunidades afines." wrapText="true" />
                </VBox>

                <!-- Biografía -->
                <VBox spacing="10.0" styleClass="card">
                    <Label styleClass="section-title" text="Biografía Académica" />
                    <Separator />
                    <Label fx:id="bioLabel" styleClass="post-body" text="Aún no has escrito una biografía..." wrapText="true" />
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
