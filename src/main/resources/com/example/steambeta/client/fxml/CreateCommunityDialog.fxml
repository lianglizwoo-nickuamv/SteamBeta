<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="640.0" spacing="14.0" styleClass="modal-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.CreateCommunityDialogController">
    <padding>
        <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
    </padding>

    <!-- Encabezado con Icono y Título -->
    <VBox spacing="4.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label styleClass="title" text="Crear Nueva Comunidad Universitaria" />
        </HBox>
        <Label styleClass="muted" text="Crea tu espacio de estudio, semillero o proyecto. Te convertirás automáticamente en Administrador del espacio." />
        <Separator />
    </VBox>

    <!-- Tarjeta del Formulario Principal -->
    <VBox spacing="10.0" styleClass="card">
        <!-- Nombre y Slug -->
        <VBox spacing="4.0">
            <Label styleClass="field-label" text="NOMBRE DE LA COMUNIDAD (3 a 100 caracteres):" />
            <TextField fx:id="nameField" promptText="Ej. Semillero de Inteligencia Artificial" styleClass="input" />
        </VBox>

        <VBox spacing="4.0">
            <Label styleClass="field-label" text="IDENTIFICADOR ÚNICO (Slug sugerido en minúsculas y guiones):" />
            <TextField fx:id="slugField" promptText="ej. semillero-de-ia" styleClass="input" />
        </VBox>

        <!-- Categoría, Visibilidad y Capacidad Máxima -->
        <HBox spacing="14.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="CATEGORÍA TEMÁTICA:" />
                <ComboBox fx:id="categoryCombo" maxWidth="Infinity" styleClass="combo-box" />
            </VBox>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="VISIBILIDAD DE ACCESO:" />
                <ComboBox fx:id="visibilityCombo" maxWidth="Infinity" styleClass="combo-box" />
            </VBox>
            <VBox prefWidth="165.0" spacing="4.0">
                <Label styleClass="field-label" text="CAPACIDAD MÁXIMA:" />
                <Spinner fx:id="maxMembersSpinner" editable="true" maxWidth="Infinity" />
            </VBox>
        </HBox>
        <Label styleClass="muted" text="Establece cuántos estudiantes podrán formar parte de tu comunidad (2 a 50). El creador también cuenta como integrante y no se admitirán más miembros al alcanzar el límite." wrapText="true" />

        <!-- Descripción y Normas -->
        <VBox spacing="4.0">
            <Label styleClass="field-label" text="PROPÓSITO Y OBJETIVOS:" />
            <TextArea fx:id="descriptionArea" prefRowCount="3" promptText="Describe brevemente de qué trata este espacio y quiénes pueden participar..." styleClass="text-area" wrapText="true" />
        </VBox>

        <VBox spacing="4.0">
            <Label styleClass="field-label" text="NORMAS DE CONVIVENCIA Y RIGOR ACADÉMICO:" />
            <TextArea fx:id="rulesArea" prefRowCount="2" promptText="Normas de respeto y colaboración constructiva..." styleClass="text-area" wrapText="true" />
        </VBox>

        <Label fx:id="errorLabel" managed="false" styleClass="status-error" text="" visible="false" wrapText="true" />
    </VBox>

    <!-- Indicador de Flujo Administrativo -->
    <VBox spacing="4.0" styleClass="card-elevated">
        <Label styleClass="badge-admin" text="Información de Rol Administrativo:" />
        <Label styleClass="muted" text="• Al crear la comunidad, serás registrado como Administrador local (ADMIN)." wrapText="true" />
        <Label styleClass="muted" text="• Para comunidades de tipo INVITE_ONLY o PRIVATE, se generará de inmediato tu código único de invitación." wrapText="true" />
    </VBox>

    <!-- Botones de Acción -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnCancel" onAction="#onCancel" styleClass="secondary" text="Cancelar" />
        <Button fx:id="btnSubmit" onAction="#onSubmit" styleClass="primary" text="+ Crear Comunidad Directamente" />
    </HBox>
</VBox>
