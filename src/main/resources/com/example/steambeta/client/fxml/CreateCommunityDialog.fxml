<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="640.0" spacing="16.0" style="-fx-background-color: #0b1120; -fx-padding: 24; -fx-border-color: #1e293b; -fx-border-width: 1; -fx-border-radius: 8;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.CreateCommunityDialogController">
    <!-- Encabezado con Icono y Título -->
    <VBox spacing="4.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label styleClass="brand" text="🏛️" />
            <VBox spacing="2.0">
                <Label styleClass="title" text="Crear Nueva Comunidad Universitaria" />
                <Label styleClass="muted" text="Crea tu espacio de estudio, semillero o proyecto. Te convertirás automáticamente en Administrador del espacio." />
            </VBox>
        </HBox>
        <Separator />
    </VBox>

    <!-- Tarjeta del Formulario Principal -->
    <VBox spacing="12.0" style="-fx-background-color: #161f30; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #233148; -fx-border-radius: 8;">
        <!-- Nombre y Slug -->
        <VBox spacing="4.0">
            <Label styleClass="field-label" text="NOMBRE DE LA COMUNIDAD (3 a 100 caracteres):" />
            <TextField fx:id="nameField" promptText="Ej. Semillero de Inteligencia Artificial" />
        </VBox>

        <VBox spacing="4.0">
            <Label styleClass="field-label" text="IDENTIFICADOR ÚNICO (Slug sugerido en minúsculas y guiones):" />
            <TextField fx:id="slugField" promptText="ej. semillero-de-ia" style="-fx-font-family: 'Consolas', monospace;" />
        </VBox>

        <!-- Categoría y Visibilidad -->
        <HBox spacing="16.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="CATEGORÍA TEMÁTICA (Contrato V6):" />
                <ComboBox fx:id="categoryCombo" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="VISIBILIDAD DE ACCESO:" />
                <ComboBox fx:id="visibilityCombo" maxWidth="Infinity" />
            </VBox>
        </HBox>

        <!-- Descripción y Normas -->
        <VBox spacing="4.0">
            <Label styleClass="field-label" text="PROPÓSITO Y OBJETIVOS:" />
            <TextArea fx:id="descriptionArea" prefRowCount="3" promptText="Describe brevemente de qué trata este espacio y quiénes pueden participar..." wrapText="true" />
        </VBox>

        <VBox spacing="4.0">
            <Label styleClass="field-label" text="NORMAS DE CONVIVENCIA Y RIGOR ACADÉMICO:" />
            <TextArea fx:id="rulesArea" prefRowCount="2" promptText="Normas de respeto y colaboración constructiva..." wrapText="true" />
        </VBox>

        <Label fx:id="errorLabel" style="-fx-text-fill: #f87171; -fx-font-weight: bold;" text="" visible="false" wrapText="true" />
    </VBox>

    <!-- Indicador de Flujo Administrativo -->
    <VBox spacing="4.0" style="-fx-background-color: #0f172a; -fx-padding: 12; -fx-background-radius: 6; -fx-border-color: #1e293b; -fx-border-radius: 6;">
        <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #38bdf8;" text="ℹ️ Creación Directa y Rol Administrativo:" />
        <Label styleClass="muted" text="• Al crear la comunidad, serás registrado como Administrador local (ADMIN)." wrapText="true" />
        <Label styleClass="muted" text="• Para comunidades de tipo INVITE_ONLY o PRIVATE, se generará de inmediato tu código único de invitación (50 usos, 30 días de vigencia)." wrapText="true" />
    </VBox>

    <!-- Botones de Acción -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnCancel" onAction="#onCancel" styleClass="secondary" text="Cancelar" />
        <Button fx:id="btnSubmit" onAction="#onSubmit" styleClass="primary" text="+ Crear Comunidad Directamente" />
    </HBox>
</VBox>
