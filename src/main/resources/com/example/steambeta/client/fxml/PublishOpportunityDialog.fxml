<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="600.0" spacing="14.0" styleClass="modal-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.PublishOpportunityDialogController">
    <padding>
        <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
    </padding>

    <!-- Encabezado -->
    <VBox spacing="4.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label styleClass="title" text="Publicar Oportunidad Campus" />
        </HBox>
        <Label styleClass="muted" text="Comparte becas, pasantías, concursos u otras convocatorias de interés universitario." />
        <Separator />
    </VBox>

    <!-- Formulario -->
    <VBox spacing="10.0" styleClass="card">
        <!-- Título -->
        <VBox spacing="4.0">
            <Label styleClass="field-label" text="TÍTULO DE LA OPORTUNIDAD (2–160 caracteres):" />
            <TextField fx:id="titleField" promptText="Ej. Beca de Movilidad Internacional 2026 / Hackathon Universitario" styleClass="input" />
        </VBox>

        <!-- Categoría y Entidad Convocante -->
        <HBox spacing="14.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="TIPO DE CONVOCATORIA:" />
                <ComboBox fx:id="categoryCombo" maxWidth="Infinity" styleClass="combo-box" />
            </VBox>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="ENTIDAD O INSTITUCIÓN CONVOCANTE:" />
                <TextField fx:id="targetOrgField" promptText="Ej. Vicerrectoría / Empresa Aliada" styleClass="input" />
            </VBox>
        </HBox>

        <!-- Descripción -->
        <VBox spacing="4.0">
            <Label styleClass="field-label" text="DESCRIPCIÓN DE LA OPORTUNIDAD:" />
            <TextArea fx:id="descriptionArea" prefRowCount="3" promptText="Requisitos principales, beneficios y proceso de postulación..." styleClass="text-area" wrapText="true" />
        </VBox>

        <!-- Enlace Externo y Fecha Límite -->
        <HBox spacing="14.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="ENLACE OFICIAL DE POSTULACIÓN (Opcional):" />
                <TextField fx:id="externalUrlField" promptText="https://convocatorias.universidad.edu/..." styleClass="input" />
            </VBox>
            <VBox maxWidth="180.0" prefWidth="170.0" spacing="4.0">
                <Label styleClass="field-label" text="FECHA DE CIERRE (Opcional):" />
                <DatePicker fx:id="deadlinePicker" maxWidth="Infinity" promptText="dd/mm/aaaa" />
            </VBox>
        </HBox>

        <Label fx:id="errorLabel" managed="false" styleClass="status-error" text="" visible="false" wrapText="true" />
    </VBox>

    <!-- Botones de Acción -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnCancel" onAction="#onCancel" styleClass="secondary" text="Cancelar" />
        <Button fx:id="btnSubmit" onAction="#onSubmit" styleClass="primary" text="+ Publicar Convocatoria" />
    </HBox>
</VBox>
