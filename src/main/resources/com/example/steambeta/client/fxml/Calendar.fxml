<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.CalendarController">
    <VBox spacing="14.0">
        <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
        </padding>

        <!-- Cabecera de Módulo -->
        <VBox spacing="10.0">
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <VBox spacing="4.0">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label styleClass="title" text="Calendario Académico y Fechas Clave" />
                        <Label styleClass="badge-admin" text="AGENDA CAMPUS" />
                    </HBox>
                    <Label styleClass="muted" text="Fechas límite de entregas, exámenes y sesiones colaborativas de tus comunidades." />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#onRefresh" styleClass="secondary" text="Actualizar Calendario" />
            </HBox>
            <Separator />
        </VBox>

        <!-- Filtros por tipo de evento -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label styleClass="field-label" text="Filtrar por tipo:" />
            <Button fx:id="filterAllBtn" onAction="#onFilterAll" styleClass="tab-btn-active" text="Todos" />
            <Button fx:id="filterExamsBtn" onAction="#onFilterExams" styleClass="tab-btn" text="📝 Exámenes" />
            <Button fx:id="filterSubsBtn" onAction="#onFilterSubs" styleClass="tab-btn" text="📦 Entregas" />
            <Button fx:id="filterMeetingsBtn" onAction="#onFilterMeetings" styleClass="tab-btn" text="👥 Reuniones" />
        </HBox>

        <Label fx:id="statusLabel" styleClass="muted" text="Consultando eventos próximos…" />

        <!-- Listado de Eventos -->
        <VBox fx:id="eventsListBox" spacing="12.0" />
    </VBox>
</ScrollPane>
