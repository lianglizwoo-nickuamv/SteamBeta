<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="app-background" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.SettingsController">
    <VBox spacing="16.0">
        <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
        </padding>

        <!-- Cabecera de Módulo -->
        <VBox spacing="10.0">
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <VBox spacing="4.0">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label styleClass="title" text="Configuración y Estado del Sistema" />
                        <Label styleClass="badge-admin" text="DIAGNÓSTICO" />
                    </HBox>
                    <Label styleClass="muted" text="Parámetros de conexión, seguridad de sesión y entorno institucional." />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#onPingConnection" styleClass="primary" text="Comprobar Conexión" />
            </HBox>
            <Separator />
        </VBox>

        <!-- Tarjeta 1: Entorno y Backend -->
        <VBox spacing="8.0" styleClass="card">
            <Label styleClass="section-title" text="Servidor Central y Base de Datos" />
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label styleClass="field-label" text="Entorno activo:" />
                <Label fx:id="envBadge" styleClass="badge-admin" text="LOCAL" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label styleClass="field-label" text="URL de conexión API:" />
                <Label fx:id="apiUrlLabel" styleClass="card-title" text="http://localhost:8080" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label styleClass="field-label" text="Motor de Base de Datos:" />
                <Label styleClass="badge-resolved" text="PostgreSQL · steam_academico" />
            </HBox>
            <Label styleClass="muted" text="Esquema relacional administrado por Flyway con Row-Level Security y funciones SECURITY DEFINER." />
        </VBox>

        <!-- Tarjeta 2: Seguridad -->
        <VBox spacing="8.0" styleClass="card">
            <Label styleClass="section-title" text="Seguridad y Protección de Sesión" />
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label styleClass="field-label" text="Tokens CSRF:" />
                <Label styleClass="badge-resolved" text="Activos en cada mutación de datos" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label styleClass="field-label" text="Políticas PostgreSQL:" />
                <Label styleClass="badge-resolved" text="Default-Deny RLS estricto" />
            </HBox>
            <Label styleClass="muted" text="El cliente de escritorio no almacena contraseñas en texto plano ni se conecta directamente a PostgreSQL." />
        </VBox>

        <!-- Tarjeta 3: Diagnóstico en Vivo -->
        <VBox spacing="8.0" styleClass="card">
            <Label styleClass="section-title" text="Diagnóstico de Conexión en Tiempo Real" />
            <Label fx:id="pingStatusLabel" styleClass="muted" text="Haz clic en 'Comprobar Conexión' para verificar la latencia con el backend." wrapText="true" />
        </VBox>
    </VBox>
</ScrollPane>
