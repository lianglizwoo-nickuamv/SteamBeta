<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="app-background" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.SettingsController">
    <VBox spacing="16.0">
        <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
        </padding>

        <!-- Cabecera de Módulo -->
        <VBox spacing="10.0">
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <VBox spacing="4.0">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label styleClass="title" text="Configuración y Estado del Sistema" />
                        <Label styleClass="badge-admin" text="DIAGNÓSTICO" />
                    </HBox>
                    <Label styleClass="muted" text="Parámetros de conexión, seguridad de sesión y entorno institucional." />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#onPingConnection" styleClass="primary" text="Comprobar Conexión" />
            </HBox>
            <Separator />
        </VBox>

        <!-- Sección 1: Preferencias de Usuario -->
        <VBox spacing="10.0" styleClass="card">
            <Label styleClass="section-title" text="Preferencias de Usuario y Aplicación" />
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label styleClass="field-label" text="Apariencia:" />
                <Label styleClass="badge-admin" text="Grafito Oscuro + Acentos Esmeralda (Predeterminado)" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label styleClass="field-label" text="Notificaciones:" />
                <Label styleClass="muted" text="Avisos de entregas, exámenes y menciones comunitarias activadas." />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label styleClass="field-label" text="Privacidad de perfil:" />
                <Label styleClass="muted" text="Configurable desde tu Perfil (visibilidad de correo institucional)." />
            </HBox>
        </VBox>

        <!-- Sección 2: Diagnóstico Técnico del Sistema -->
        <VBox spacing="8.0" styleClass="card">
            <Label styleClass="section-title" text="Diagnóstico Técnico y Conectividad" />
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label styleClass="field-label" text="Entorno configurado:" />
                <Label fx:id="envBadge" styleClass="badge-admin" text="LOCAL" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label styleClass="field-label" text="URL del Backend:" />
                <Label fx:id="apiUrlLabel" styleClass="identity" text="http://localhost:8080" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label styleClass="field-label" text="Base de Datos:" />
                <Label styleClass="badge-resolved" text="PostgreSQL (steam_academico · V13)" />
            </HBox>
            <Separator />
            <Label fx:id="pingStatusLabel" styleClass="muted" text="Pulsa 'Comprobar Conexión' para medir la latencia y validar el estado de sesión en tiempo real." wrapText="true" />
        </VBox>
    </VBox>
</ScrollPane>
