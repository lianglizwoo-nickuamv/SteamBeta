<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600.0" prefWidth="780.0" spacing="14.0" styleClass="modal-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.ExploreCommunitiesDialogController">
    <padding>
        <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
    </padding>

    <!-- Encabezado -->
    <VBox spacing="4.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label styleClass="title" text="Catálogo de Comunidades Públicas" />
        </HBox>
        <Label styleClass="muted" text="Consulta los espacios académicos, grupos de estudio y proyectos abiertos en SteamBeta Campus." />
        <Separator />
    </VBox>

    <!-- Barra de Búsqueda y Filtros -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="toolbar-strip">
        <TextField fx:id="searchField" onAction="#onFilter" prefWidth="280.0" promptText="Buscar por nombre o descripción..." styleClass="input" />
        <ComboBox fx:id="categoryFilterCombo" onAction="#onFilter" prefWidth="170.0" styleClass="combo-box" />
        <Button onAction="#onFilter" styleClass="secondary" text="Buscar" />
        <Button onAction="#onReset" styleClass="secondary" text="Restablecer" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#onRefresh" styleClass="secondary" text="Actualizar" />
    </HBox>

    <Label fx:id="statusLabel" styleClass="muted" text="Cargando espacios..." />

    <!-- Listado con Scroll -->
    <ScrollPane fitToWidth="true" styleClass="app-background" VBox.vgrow="ALWAYS">
        <VBox fx:id="listBox" spacing="12.0">
            <padding>
                <Insets bottom="8.0" left="4.0" right="4.0" top="4.0" />
            </padding>
        </VBox>
    </ScrollPane>

    <!-- Pie -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Button onAction="#onClose" styleClass="secondary" text="Cerrar" />
    </HBox>
</VBox>
