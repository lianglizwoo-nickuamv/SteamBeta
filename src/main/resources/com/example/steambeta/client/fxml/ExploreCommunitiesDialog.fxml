<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600.0" prefWidth="780.0" spacing="16.0" style="-fx-background-color: #0b1120; -fx-padding: 24; -fx-border-color: #1e293b; -fx-border-width: 1; -fx-border-radius: 8;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.ExploreCommunitiesDialogController">
    <!-- Encabezado -->
    <VBox spacing="4.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label styleClass="brand" text="🌐" />
            <Label styleClass="title" text="Catálogo de Comunidades Públicas" />
        </HBox>
        <Label styleClass="muted" text="Consulta los espacios académicos, grupos de estudio y proyectos abiertos en SteamBeta Campus." />
        <Separator />
    </VBox>

    <!-- Barra de Búsqueda y Filtros -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <TextField fx:id="searchField" onAction="#onFilter" prefWidth="320.0" promptText="Buscar por nombre o descripción..." />
        <ComboBox fx:id="categoryFilterCombo" prefWidth="180.0" promptText="Todas las categorías" />
        <Button onAction="#onFilter" styleClass="secondary" text="🔍 Buscar" />
        <Button onAction="#onReset" styleClass="secondary" text="Limpiar" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#onRefresh" styleClass="secondary" text="Actualizar" />
    </HBox>

    <Label fx:id="statusLabel" styleClass="muted" text="Consultando comunidades públicas disponibles…" />

    <!-- Listado con Scroll -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
        <VBox fx:id="listBox" spacing="12.0">
            <padding>
                <Insets bottom="10.0" left="4.0" right="10.0" top="4.0" />
            </padding>
        </VBox>
    </ScrollPane>

    <!-- Pie de Ventana -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnClose" onAction="#onClose" styleClass="secondary" text="Cerrar" />
    </HBox>
</VBox>
