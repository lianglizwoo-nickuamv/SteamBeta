<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="8.0" styleClass="question-card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.QuestionCardController">
    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label fx:id="stateBadge" styleClass="badge-pending" text="○ PENDIENTE" />
        <Label fx:id="subjectBadge" managed="false" styleClass="tag-pill" text="Materia" visible="false" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="authorDateLabel" styleClass="muted" text="Por: Sofia · 01/01/2026" />
    </HBox>

    <Label fx:id="titleLabel" styleClass="card-title" text="Título de la duda o ejercicio" wrapText="true" />
    <Label fx:id="bodyLabel" styleClass="post-body" text="Descripción detallada de la pregunta..." wrapText="true" />

    <Separator />

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label fx:id="repliesBadge" styleClass="badge-role" text="0 respuestas / aportes" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="openBtn" onAction="#onOpen" styleClass="secondary, btn-compact" text="Ver respuestas y soluciones →" />
    </HBox>
</VBox>
