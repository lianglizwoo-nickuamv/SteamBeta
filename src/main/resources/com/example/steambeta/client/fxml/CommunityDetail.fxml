<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" styleClass="app-background" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.CommunityDetailController">
    <center>
        <ScrollPane fitToWidth="true" styleClass="app-background">
            <VBox spacing="14.0">
                <padding>
                    <Insets bottom="24.0" left="24.0" right="24.0" top="16.0" />
                </padding>

                <!-- Botón Volver y Cabecera de Comunidad -->
                <Button onAction="#onBackToHome" styleClass="secondary" text="← Mis Comunidades" />

                <VBox spacing="6.0" styleClass="card">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label fx:id="communityNameLabel" styleClass="title" text="Nombre de la Comunidad" />
                        <Label fx:id="roleBadge" styleClass="badge-role" text="Rol: MEMBER" />
                    </HBox>
                    <Label fx:id="descLabel" styleClass="muted" text="Descripción de la comunidad..." wrapText="true" />
                    <Label fx:id="rulesLabel" styleClass="muted" text="Reglas: Respeto mutuo y rigor académico." wrapText="true" />
                </VBox>

                <!-- Barra de Pestañas Fijas de la Comunidad -->
                <HBox fx:id="tabHeader" alignment="CENTER_LEFT" spacing="8.0">
                    <Button fx:id="btnPosts" onAction="#onTabPosts" styleClass="tab-btn-active" text="Conversaciones" />
                    <Button fx:id="btnQA" onAction="#onTabQA" styleClass="tab-btn" text="Dudas y Soluciones (Q&amp;A)" />
                    <Button fx:id="btnResources" onAction="#onTabResources" styleClass="tab-btn" text="Recursos" />
                    <Button fx:id="btnCalendar" onAction="#onTabCalendar" styleClass="tab-btn" text="Calendario" />
                    <Button fx:id="btnMembers" onAction="#onTabMembers" styleClass="tab-btn" text="Integrantes" />
                    <Button fx:id="btnModeration" managed="false" onAction="#onOpenModeration" styleClass="secondary" text="Panel de Moderación" visible="false" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnNewResource" managed="false" onAction="#onNewCommunityResource" styleClass="primary" text="+ Publicar Recurso" visible="false" />
                    <Button fx:id="btnNewCalendarEvent" managed="false" onAction="#onNewCommunityEvent" styleClass="primary" text="+ Nuevo Evento" visible="false" />
                </HBox>
                <Separator />

                <!-- Estado de la pestaña activa -->
                <Label fx:id="tabStatusLabel" managed="false" styleClass="muted" text="" visible="false" />

                <!-- Contenedor Dinámico de la Pestaña Activa -->
                <VBox fx:id="tabContentPane" spacing="12.0" />
            </VBox>
        </ScrollPane>
    </center>

    <!-- Barra Inferior Opcional para Compositores -->
    <bottom>
        <VBox fx:id="bottomComposer" managed="false" spacing="8.0" styleClass="bottom-bar" visible="false">
            <padding>
                <Insets bottom="14.0" left="24.0" right="24.0" top="10.0" />
            </padding>
            <TextField fx:id="composerTitleField" promptText="Título del tema o pregunta (3–160 caracteres)" styleClass="input" />
            <TextArea fx:id="composerBodyArea" prefRowCount="3" promptText="Explica tu duda o comentario con detalle…" styleClass="text-area" wrapText="true" />
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Button onAction="#onPublishPost" styleClass="primary" text="Publicar en la comunidad" />
                <Label fx:id="composerStatus" styleClass="error" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
