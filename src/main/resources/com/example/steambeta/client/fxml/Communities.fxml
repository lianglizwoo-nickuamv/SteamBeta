<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" styleClass="app-background" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.CommunitiesController">
    <VBox spacing="16.0">
        <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
        </padding>

        <!-- Cabecera de Módulo -->
        <VBox spacing="10.0">
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <VBox spacing="4.0">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label styleClass="title" text="Comunidades Universitarias" />
                        <Label styleClass="badge-admin" text="ESPACIOS ACADÉMICOS" />
                    </HBox>
                    <Label styleClass="muted" text="Espacios de estudio, proyectos de asignaturas, grupos por carrera y comunidades temáticas." />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Button onAction="#onCreateCommunity" styleClass="primary" text="+ Crear Comunidad" />
                    <Button onAction="#onJoinWithCode" styleClass="secondary" text="Unirse con Código" />
                    <Button onAction="#onExplorePublic" styleClass="secondary" text="Explorar Catálogo" />
                    <Button onAction="#onRefresh" styleClass="secondary" text="Actualizar" />
                </HBox>
            </HBox>
            <Separator />
        </VBox>

        <!-- Barra de Búsqueda y Filtros de Categorías -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <TextField fx:id="searchField" onAction="#onSearch" prefWidth="280.0" promptText="Filtrar por nombre o temática..." styleClass="input" />
            <Button onAction="#onSearch" styleClass="secondary" text="Filtrar" />
            <Separator orientation="VERTICAL" />
            <Button fx:id="catAllBtn" onAction="#onFilterAll" styleClass="tab-btn-active" text="Todas" />
            <Button fx:id="catAcadBtn" onAction="#onFilterAcad" styleClass="tab-btn" text="Académica" />
            <Button fx:id="catStudyBtn" onAction="#onFilterStudy" styleClass="tab-btn" text="Estudio" />
            <Button fx:id="catProjBtn" onAction="#onFilterProj" styleClass="tab-btn" text="Proyectos" />
            <Button fx:id="catCareerBtn" onAction="#onFilterCareer" styleClass="tab-btn" text="Carrera" />
            <Button fx:id="catInterestBtn" onAction="#onFilterInterest" styleClass="tab-btn" text="Interés" />
        </HBox>

        <Label fx:id="statusLabel" styleClass="muted" text="Cargando tus comunidades desde PostgreSQL..." />

        <!-- Disposición en 2 Columnas: Lista de Comunidades y Panel Informativo -->
        <HBox spacing="20.0">
            <!-- Columna Izquierda: Tarjetas de Comunidades -->
            <VBox fx:id="communityListBox" spacing="12.0" HBox.hgrow="ALWAYS" />

            <!-- Columna Derecha: Panel de Resumen de Participación -->
            <VBox maxWidth="320.0" minWidth="280.0" prefWidth="300.0" spacing="14.0">
                <VBox spacing="10.0" styleClass="card">
                    <Label styleClass="section-title" text="Participación y Roles" />
                    <Label styleClass="muted" text="En SteamBeta, al crear una comunidad te conviertes en su Administrador Local, con capacidad para emitir códigos de invitación únicos y moderar contenidos de la comunidad." wrapText="true" />
                    <Separator />
                    <Label styleClass="field-label" text="CONSEJOS RÁPIDOS" />
                    <Label styleClass="muted" text="• Utiliza 'Unirse con Código' para ingresar a comunidades cerradas de tus docentes o equipos." wrapText="true" />
                    <Label styleClass="muted" text="• Explora comunidades públicas en el catálogo del campus para conectar con compañeros de tu carrera." wrapText="true" />
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
