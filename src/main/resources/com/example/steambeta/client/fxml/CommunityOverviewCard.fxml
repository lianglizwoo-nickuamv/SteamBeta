<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10.0" styleClass="card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.CommunityOverviewCardController">
    <!-- Encabezado con Nombre, Categoría, Privacidad y Estado -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label fx:id="nameLabel" styleClass="card-title" text="Nombre del Espacio Universitario" />
        <Label fx:id="categoryBadge" styleClass="brand-badge" text="Académica" />
        <Label fx:id="visibilityBadge" styleClass="badge-admin" text="Pública" />
        <Label fx:id="fullBadge" managed="false" styleClass="badge-pending" text="Comunidad llena" visible="false" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="membershipBadge" managed="false" styleClass="badge-resolved" text="✓ Miembro" visible="false" />
    </HBox>

    <!-- Metadatos públicos y ocupación -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <HBox alignment="CENTER_LEFT" spacing="6.0">
            <Label styleClass="muted" text="Identificador:" />
            <Label fx:id="slugLabel" styleClass="identity" text="slug-comunidad" />
        </HBox>
        <Separator orientation="VERTICAL" />
        <Label fx:id="membersLabel" styleClass="muted" text="1 / 50 integrantes" />
        <Label fx:id="slotsLabel" styleClass="muted" text="49 espacios disponibles" />
        <Region HBox.hgrow="ALWAYS" />
        <ProgressBar fx:id="capacityBar" prefHeight="8.0" prefWidth="130.0" progress="0.02" />
    </HBox>

    <!-- Descripción pública -->
    <Label fx:id="descLabel" styleClass="post-body" text="Descripción del espacio universitario..." wrapText="true" />

    <Separator />

    <!-- Barra Inferior: Indicador de acceso y Botón contextual -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label fx:id="roleLabel" styleClass="muted" text="Acceso abierto" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnDetails" onAction="#onDetails" styleClass="primary" text="Unirse" />
    </HBox>
</VBox>
