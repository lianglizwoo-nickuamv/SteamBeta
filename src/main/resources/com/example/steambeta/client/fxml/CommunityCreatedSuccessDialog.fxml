<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="540.0" spacing="14.0" styleClass="modal-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.CommunityCreatedSuccessDialogController">
    <padding>
        <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
    </padding>

    <!-- Encabezado con Icono y Título -->
    <VBox spacing="4.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label styleClass="title" text="¡Comunidad Creada Exitosamente!" />
        </HBox>
        <Label styleClass="muted" text="Tu espacio universitario ya está disponible en SteamBeta Campus." />
        <Separator />
    </VBox>

    <!-- Ficha de la Comunidad Creada -->
    <VBox spacing="10.0" styleClass="card">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label fx:id="nameLabel" styleClass="card-title" text="Nombre de la Comunidad" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="categoryBadge" styleClass="brand-badge" text="ACADEMICA" />
            <Label fx:id="visibilityBadge" styleClass="badge-admin" text="INVITE_ONLY" />
        </HBox>

        <Label fx:id="roleLabel" styleClass="status-success" text="Tu rol asignado: Administrador Local (ADMIN)" />

        <!-- Bloque de Código de Invitación -->
        <VBox fx:id="invitationBlock" spacing="6.0" styleClass="dialog-info-card">
            <Label styleClass="field-label" text="CÓDIGO ÚNICO DE INVITACIÓN GENERADO:" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <TextField fx:id="codeField" editable="false" prefWidth="240.0" styleClass="input" text="CAMPUS1234" />
                <Button fx:id="btnCopy" onAction="#onCopyCode" styleClass="primary" text="Copiar Código" />
            </HBox>
            <Label styleClass="muted" text="Comparte este código con tus compañeros para que se unan directamente." wrapText="true" />
        </VBox>
    </VBox>

    <!-- Botón de Cerrar -->
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button onAction="#onClose" styleClass="secondary" text="Entrar al Espacio Universitario" />
    </HBox>
</VBox>
