<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="500.0" spacing="14.0" styleClass="modal-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.JoinCommunityDialogController">
    <padding>
        <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
    </padding>

    <!-- Encabezado Visual -->
    <VBox spacing="4.0">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label styleClass="title" text="Unirse con Código" />
        </HBox>
        <Label styleClass="muted" text="Introduce el código alfanumérico emitido por el administrador de la comunidad." />
        <Separator />
    </VBox>

    <!-- Tarjeta de Ingreso de Código -->
    <VBox spacing="10.0" styleClass="card">
        <Label styleClass="field-label" text="CÓDIGO DE INVITACIÓN (Ej. CAMPUS9X2Z):" />
        <TextField fx:id="codeField" promptText="Pega el código aquí..." styleClass="input" />
        <Label fx:id="statusLabel" managed="false" styleClass="status-error" visible="false" />
    </VBox>

    <!-- Botones de Acción -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnCancel" onAction="#onCancel" styleClass="secondary" text="Cancelar" />
        <Button fx:id="btnJoin" onAction="#onJoin" styleClass="primary" text="Unirse al Espacio" />
    </HBox>
</VBox>
