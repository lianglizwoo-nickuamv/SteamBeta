<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="6.0" styleClass="card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.OpportunityCardController">
    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label fx:id="catBadge" styleClass="badge-role" text="SCHOLARSHIP" />
        <Label fx:id="instBadge" styleClass="badge-admin" text="Universidad" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="dueLabel" styleClass="muted" text="Vence: 01/01" />
    </HBox>

    <Label fx:id="titleLabel" styleClass="card-title" text="Título de la convocatoria" />
    <Label fx:id="descLabel" styleClass="muted" text="Descripción de requisitos y beneficios..." wrapText="true" />

    <HBox fx:id="linkRow" alignment="CENTER_LEFT" managed="false" visible="false">
        <Button fx:id="copyBtn" onAction="#onCopyLink" style="-fx-font-size: 11px; -fx-padding: 3 8;" styleClass="secondary" text="📋 Copiar enlace" />
    </HBox>
</VBox>
