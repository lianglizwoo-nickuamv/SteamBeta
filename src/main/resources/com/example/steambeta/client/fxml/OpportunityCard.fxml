<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="8.0" styleClass="opportunity-card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.OpportunityCardController">
    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label fx:id="catBadge" styleClass="badge-role" text="Beca" />
        <Label fx:id="instBadge" styleClass="badge-admin" text="Universidad" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="dueLabel" styleClass="event-date-chip" text="Cierra: 01/01" />
    </HBox>

    <Label fx:id="titleLabel" styleClass="card-title" text="Título de la convocatoria" wrapText="true" />
    <Label fx:id="descLabel" styleClass="post-body" text="Descripción de requisitos y beneficios..." wrapText="true" />

    <Separator />

    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <HBox fx:id="linkRow" alignment="CENTER_LEFT" managed="false" spacing="6.0" visible="false">
            <Button fx:id="openBtn" onAction="#onOpenLink" styleClass="primary, btn-compact" text="Abrir enlace oficial" />
            <Button fx:id="copyBtn" onAction="#onCopyLink" styleClass="secondary, btn-compact" text="Copiar enlace" />
        </HBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnEdit" managed="false" onAction="#onEdit" styleClass="secondary, btn-compact" text="Editar" visible="false" />
        <Button fx:id="btnDelete" managed="false" onAction="#onDelete" styleClass="danger-btn, btn-compact" text="Eliminar" visible="false" />
    </HBox>
</VBox>
