<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToHeight="true" fitToWidth="true" styleClass="app-background" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.AuthController">
    <StackPane alignment="CENTER">
        <padding>
            <Insets bottom="32.0" left="24.0" right="24.0" top="32.0" />
        </padding>

        <HBox alignment="CENTER" maxWidth="1020.0" spacing="28.0">
            <!-- Columna Izquierda: Introducción y Marca Institucional -->
            <VBox fx:id="introCard" alignment="CENTER_LEFT" maxWidth="420.0" prefWidth="390.0" spacing="18.0" styleClass="auth-intro-card">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label styleClass="brand" text="SteamBeta" />
                    <Label styleClass="brand-badge" text="CAMPUS" />
                </HBox>
                <Label styleClass="display" text="Tu espacio universitario,&#10;conectado." />
                <Label styleClass="muted" text="Organiza tus tareas, construye tu perfil académico, conecta con comunidades estudiantiles y colabora en proyectos universitarios." wrapText="true" />
            </VBox>

            <!-- Columna Derecha: Tarjeta de Formulario Unificada -->
            <VBox fx:id="formCard" alignment="CENTER_LEFT" maxWidth="540.0" prefWidth="500.0" spacing="14.0" styleClass="auth-card">
                <!-- Panel de Inicio de Sesión -->
                <VBox fx:id="loginPane" spacing="12.0">
                    <Label styleClass="title" text="Bienvenido a SteamBeta Campus" />
                    <Label styleClass="muted" text="Ingresa tus credenciales para acceder a la plataforma." />

                    <Label styleClass="field-label" text="Identificador o correo electrónico" />
                    <TextField fx:id="loginIdentifierField" promptText="Ej. sofia.m o sofia@universidad.edu" />

                    <Label styleClass="field-label" text="Contraseña" />
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <StackPane HBox.hgrow="ALWAYS">
                            <PasswordField fx:id="loginPasswordField" promptText="Tu contraseña institucional" />
                            <TextField fx:id="loginPasswordVisField" managed="false" promptText="Tu contraseña institucional" visible="false" />
                        </StackPane>
                        <Button fx:id="toggleLoginPassBtn" onAction="#onToggleLoginPassword" styleClass="secondary" text="Ver" />
                    </HBox>

                    <Button fx:id="loginSubmitBtn" defaultButton="true" maxWidth="Infinity" onAction="#onLoginSubmit" styleClass="primary" text="Iniciar sesión" />
                    <Button maxWidth="Infinity" onAction="#onShowRegister" styleClass="secondary" text="Crear cuenta de estudiante" />
                </VBox>

                <!-- Panel de Registro de Estudiante — Paso 1: Datos de Acceso -->
                <VBox fx:id="registerPane" managed="false" spacing="11.0" visible="false">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label styleClass="title" text="Registro de Estudiante" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="badge-admin" text="PASO 1 DE 2" />
                    </HBox>
                    <Label styleClass="muted" text="Completa tus datos básicos de acceso para activar tu cuenta en SteamBeta Campus." wrapText="true" />

                    <Label styleClass="field-label" text="1. Nombre o alias público" />
                    <TextField fx:id="regAliasField" promptText="Tu nombre visible (ej. Sofía Martínez)" />

                    <Label styleClass="field-label" text="2. Identificador de acceso único" />
                    <TextField fx:id="regLoginField" promptText="Identificador (ej. sofia.m)" />

                    <Label styleClass="field-label" text="3. Correo electrónico" />
                    <TextField fx:id="regEmailField" promptText="Correo (ej. sofia@universidad.edu)" />

                    <Label styleClass="field-label" text="4. Contraseña segura" />
                    <StackPane>
                        <PasswordField fx:id="regPasswordField" promptText="Mínimo 12 caracteres" />
                        <TextField fx:id="regPasswordVisField" managed="false" promptText="Mínimo 12 caracteres" visible="false" />
                    </StackPane>

                    <Label styleClass="field-label" text="5. Confirmar contraseña" />
                    <StackPane>
                        <PasswordField fx:id="regConfirmField" promptText="Repite tu contraseña" />
                        <TextField fx:id="regConfirmVisField" managed="false" promptText="Repite tu contraseña" visible="false" />
                    </StackPane>

                    <Button onAction="#onToggleRegPasswords" styleClass="secondary" text="Ver / Ocultar contraseñas" />

                    <!-- Indicadores en tiempo real -->
                    <VBox spacing="4.0">
                        <Label fx:id="hintLength" styleClass="hint-neutral" text="• Mínimo 12 caracteres" />
                        <Label fx:id="hintMatch" styleClass="hint-neutral" text="• Las contraseñas deben coincidir" />
                        <Label fx:id="hintBytes" styleClass="hint-neutral" text="• Máximo 72 bytes de longitud" />
                        <Label fx:id="hintEmail" styleClass="hint-neutral" text="• Correo con formato válido (@)" />
                    </VBox>

                    <!-- Tarjeta informativa de privacidad -->
                    <VBox spacing="4.0" styleClass="dialog-info-card">
                        <Label styleClass="card-title" text="Tu privacidad académica" />
                        <Label styleClass="muted" text="Tu correo electrónico permanecerá confidencial en PostgreSQL." wrapText="true" />
                    </VBox>

                    <Button fx:id="registerSubmitBtn" defaultButton="true" maxWidth="Infinity" onAction="#onRegisterSubmit" styleClass="primary" text="Crear mi cuenta y continuar" />
                    <Button maxWidth="Infinity" onAction="#onShowLogin" styleClass="secondary" text="Ya tengo una cuenta: Volver al inicio" />
                </VBox>

                <!-- Panel de Presentación Académica — Paso 2 (Opcional tras crear la cuenta) -->
                <VBox fx:id="onboardingPane" managed="false" spacing="11.0" visible="false">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label styleClass="title" text="Presentación Académica" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label styleClass="badge-resolved" text="PASO 2 DE 2 · OPCIONAL" />
                    </HBox>
                    <Label styleClass="muted" text="Completa tu identidad estudiantil para que tus compañeros te reconozcan. También puedes omitir este paso y completarlo después desde Mi Perfil." wrapText="true" />
                    <Separator />

                    <!-- Fotografía de perfil opcional con vista previa -->
                    <HBox alignment="CENTER_LEFT" spacing="14.0">
                        <StackPane prefHeight="60.0" prefWidth="60.0" styleClass="avatar-circle">
                            <ImageView fx:id="onbAvatarImage" fitHeight="60.0" fitWidth="60.0" managed="false" visible="false" />
                            <Label fx:id="onbAvatarInitials" styleClass="avatar-initials" text="ST" />
                        </StackPane>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="FOTOGRAFÍA DE PERFIL (Opcional)" />
                            <HBox spacing="8.0">
                                <Button fx:id="onbChoosePhotoBtn" onAction="#onChooseOnboardingPhoto" styleClass="secondary" text="Elegir fotografía" />
                                <Button fx:id="onbRemovePhotoBtn" managed="false" onAction="#onRemoveOnboardingPhoto" styleClass="danger-btn" text="Quitar" visible="false" />
                            </HBox>
                            <Label fx:id="onbPhotoHintLabel" styleClass="muted" text="JPG, PNG o WEBP · máximo 5 MB." wrapText="true" />
                        </VBox>
                    </HBox>

                    <HBox spacing="10.0">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="UNIVERSIDAD" />
                            <TextField fx:id="onbUniField" promptText="Ej. Universidad Nacional de Ingeniería" />
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="CARRERA O ESPECIALIDAD" />
                            <TextField fx:id="onbCareerField" promptText="Ej. Ingeniería en Computación" />
                        </VBox>
                    </HBox>

                    <HBox spacing="10.0">
                        <VBox prefWidth="135.0" spacing="4.0">
                            <Label styleClass="field-label" text="SEMESTRE (1–20)" />
                            <TextField fx:id="onbSemesterField" promptText="Ej. 5" />
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="INTERESES ACADÉMICOS" />
                            <TextField fx:id="onbInterestsField" promptText="Ej. Algoritmos, IA, Bases de Datos..." />
                        </VBox>
                    </HBox>

                    <VBox spacing="4.0">
                        <Label styleClass="field-label" text="BIOGRAFÍA ACADÉMICA (Opcional, hasta 500 caracteres)" />
                        <TextArea fx:id="onbBioArea" prefRowCount="3" promptText="Cuéntale brevemente a tus compañeros qué estudias o en qué proyectos te interesa colaborar..." wrapText="true" />
                    </VBox>

                    <HBox spacing="10.0">
                        <Button fx:id="onbSkipBtn" maxWidth="Infinity" onAction="#onSkipOnboarding" styleClass="secondary" text="Completar más tarde" HBox.hgrow="ALWAYS" />
                        <Button fx:id="onbSaveBtn" maxWidth="Infinity" onAction="#onSaveOnboarding" styleClass="primary" text="Guardar y entrar al campus" HBox.hgrow="ALWAYS" />
                    </HBox>
                </VBox>

                <!-- Barra de estado y progreso -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <ProgressIndicator fx:id="busyIndicator" managed="false" prefHeight="22.0" prefWidth="22.0" visible="false" />
                    <Label fx:id="statusLabel" wrapText="true" />
                </HBox>
            </VBox>
        </HBox>
    </StackPane>
</ScrollPane>
