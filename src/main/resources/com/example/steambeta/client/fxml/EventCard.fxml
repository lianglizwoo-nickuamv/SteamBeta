<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox onMouseClicked="#onCardClicked" spacing="6.0" styleClass="card, card-clickable" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.EventCardController">
    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label fx:id="typeBadge" styleClass="badge-role" text="EVENTO" />
        <Label fx:id="commBadge" styleClass="tag-pill" text="Comunidad" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="dateLabel" styleClass="event-date-chip" text="01/01/2026" />
    </HBox>

    <Label fx:id="titleLabel" styleClass="card-title" text="Título del examen o entrega" wrapText="true" />
    <Label fx:id="descLabel" styleClass="muted" text="Descripción o temario..." wrapText="true" />
</VBox>
