<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.steambeta.client.ui.HomeController">
    <VBox spacing="16.0">
        <padding>
            <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
        </padding>

        <!-- Cabecera de Módulo -->
        <VBox spacing="10.0">
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <VBox spacing="4.0">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label styleClass="title" text="Mis Comunidades Universitarias" />
                        <Label styleClass="badge-admin" text="CAMPUS HUB" />
                    </HBox>
                    <Label styleClass="muted" text="Espacios de estudio, proyectos, asignaturas y grupos en los que participas." />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Button onAction="#onCreateCommunity" styleClass="primary" text="+ Crear Comunidad" />
                    <Button onAction="#onJoinWithCode" styleClass="secondary" text="🔑 Unirse con Código" />
                    <Button onAction="#onExplorePublic" styleClass="secondary" text="🔍 Explorar Espacios" />
                    <Button onAction="#onRefresh" styleClass="secondary" text="Actualizar" />
                </HBox>
            </HBox>
            <Separator />
        </VBox>

        <Label fx:id="statusLabel" styleClass="muted" text="Cargando tus comunidades universitarias…" />

        <!-- Disposición en 2 Columnas: Comunidades e Hitos Próximos -->
        <HBox spacing="20.0">
            <!-- Columna Izquierda: Tarjetas de Comunidades -->
            <VBox fx:id="communityListBox" spacing="12.0" HBox.hgrow="ALWAYS" />

            <!-- Columna Derecha: Panel de Próximas Fechas Clave -->
            <VBox fx:id="upcomingCard" maxWidth="340.0" minWidth="300.0" prefWidth="320.0" spacing="10.0" styleClass="card">
                <Label styleClass="section-title" text="📅 Próximas Fechas Clave" />
                <Label styleClass="muted" text="Exámenes y entregas de tus asignaturas:" />
                <VBox fx:id="upcomingEventsBox" spacing="8.0" />
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
